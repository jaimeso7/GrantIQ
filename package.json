{
  "name": "grantiq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Grant discovery and staff workflow on Node.js for Railway and SiteGround",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.node node/server.js",
    "build": "node node/scripts/check.js",
    "test": "node --test node/tests/*.test.js",
    "import:python": "node --env-file-if-exists=.env.node node/scripts/import-python.js",
    "model:download": "node --env-file-if-exists=.env.node node/embeddings.js --download",
    "refresh": "node --env-file-if-exists=.env.node node/scripts/refresh.js",
    "rescore": "node --env-file-if-exists=.env.node node/scripts/rescore.js"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "ipaddr.js": "2.2.0",
    "pg": "8.16.3",
    "robots-parser": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
