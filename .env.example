# Local mode works on loopback without a password. Shared access requires both.
GRANTIQ_ADMIN_PASSWORD=
GRANTIQ_SECRET_KEY=
GRANTIQ_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
GRANTIQ_SECURE_COOKIES=false
# Defaults to ./data/grantiq.db. PostgreSQL: install psycopg[binary] separately.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/grantiq
# GRANTIQ_DATA_DIR=./data
# GRANTIQ_MODEL_CACHE=./data/models
# GRANTIQ_CACHE_DIR=./data/cache
# Maximum unique opportunities per refresh; increase after initial validation.
GRANTIQ_MAX_RECORDS=100
