# Local: copy to .env.node. On Railway/SiteGround use service variables instead.
# Railway accepts DATABASE_URL and automatically uses RAILWAY_PUBLIC_DOMAIN.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Hosted production requires these three settings and PostgreSQL:
# NODE_ENV=production
# HOST=0.0.0.0
# GRANTIQ_ADMIN_PASSWORD=choose-a-long-private-password
# GRANTIQ_SECRET_KEY=generate-at-least-32-random-characters
# GRANTIQ_ALLOWED_HOSTS=your-project-domain.example
# GRANTIQ_DATABASE_URL=postgresql://user:password@host:5432/database
# Use require only when the database provider supplies trusted TLS.
GRANTIQ_DATABASE_SSL=disable
# Local SQLite defaults to data/node/grantiq.sqlite, separate from Python.
# GRANTIQ_NODE_DATA_DIR=/persistent/private/path
GRANTIQ_MAX_RECORDS=100
GRANTIQ_SCHEDULER=true
# keyword is explicit fallback (35% of mission points only).
# local enables optional Transformers.js MiniLM; download first, verify host memory.
GRANTIQ_SEMANTIC_MODE=keyword
# GRANTIQ_MODEL_CACHE=/persistent/private/model-cache

# Public foundation prospects (historical IRS records, not open-grant verification).
GRANTIQ_FOUNDATION_DISCOVERY=true
# Optional broader web discovery; keep the authorized key in local/Railway secrets.
# GRANTIQ_BRAVE_API_KEY=
